# Smart Resource Allocation – Volunteer Coordination System
# Environment Variables  |  Copy this file to .env and fill in your values.

# ── Google Gemini AI (Priority 1 LLM provider) ───────────────────────────────
# Get key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenRouter API (Priority 2 LLM provider – free Mistral-7B) ───────────────
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Flask Server ──────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# ── Firebase (production deployment) ─────────────────────────────────────────
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# ── Model Persistence (optional) ─────────────────────────────────────────────
# MODEL_PATH=ai_engine_model.pkl
